{
  "name": "plan-with-daisy",
  "version": "2.1.0",
  "description": "Daisy - AI-powered task planning and execution for Claude Code",
  "type": "module",
  "bin": {
    "daisy": "./dist/cli/index.js",
    "daisy-mcp": "./dist/mcp/index.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/cli/index.js",
    "./mcp": "./dist/mcp/index.js",
    "./server": "./dist/server/index.js",
    "./schemas/config": "./schemas/config.schema.json",
    "./schemas/tasks": "./schemas/tasks.schema.json",
    "./schemas/status": "./schemas/status.schema.json",
    "./schemas/state": "./schemas/state.schema.json"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsup",
    "build:web": "cd src/web && npm run build",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsup --watch",
    "dev:web": "cd src/web && npm run dev",
    "start": "node dist/cli/index.js",
    "start:server": "node dist/server/index.js",
    "test": "vitest",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "postinstall": "cd src/web && npm install || true"
  },
  "keywords": [
    "claude-code",
    "ai",
    "development",
    "task-planning",
    "mcp",
    "model-context-protocol",
    "daisy",
    "plan-with-daisy",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-result": "^2.1.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "hono": "^4.6.14",
    "inquirer": "^12.3.0",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "standard-version": "^9.5.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

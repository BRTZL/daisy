{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/plan-with-daisy/daisy/main/schemas/tasks.schema.json",
  "title": "Daisy Tasks",
  "description": "Task definitions for daisy projects",
  "type": "array",
  "items": {
    "$ref": "#/definitions/Task"
  },
  "definitions": {
    "TaskStatus": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "skipped", "blocked"],
      "description": "Current status of the task"
    },
    "Task": {
      "type": "object",
      "required": ["id", "title", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (e.g., 'setup', 'auth-1')",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "description": "Task title",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Optional detailed description"
        },
        "status": {
          "$ref": "#/definitions/TaskStatus"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of tasks this depends on (must complete first)"
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of criteria that must be met for completion"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of times this task has been attempted"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Maximum attempts before auto-skip"
        },
        "skipReason": {
          "type": "string",
          "description": "Reason for skipping (if status is 'skipped')"
        },
        "completionSummary": {
          "type": "string",
          "description": "Summary of what was done (if status is 'completed')"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when last updated"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when completed"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Task"
          },
          "description": "Child tasks (recursive structure)"
        }
      }
    }
  }
}
